# Copy to .env (git-ignored). docker compose reads it automatically; `pnpm start` reads it via dotenv.

# Port the connector listens on.
PORT=3511
# debug | info | warn | error | none
LOG_LEVEL=info
# development | test | production. `pnpm start` uses this value; docker compose always sets production.
NODE_ENV=development
# Shared secret for Gitea webhooks. Set the same value in the webhook's Authorization Header
# field as "Bearer <secret>". Empty = webhook deliveries are accepted without authentication.
WEBHOOK_SECRET=
# Items requested per Gitea API page (Gitea caps this server-side, default cap 50).
PAGE_SIZE=50
# Maximum parallel requests to Gitea.
MAX_CONCURRENT_CONNECTIONS=10
# Seconds to wait before closing the server on SIGTERM.
WAIT_BEFORE_SERVER_CLOSE=0
# Abort a Gitea request after this many milliseconds.
REQUEST_TIMEOUT_MS=30000
# Comma-separated Gitea hosts (host or host:port) this connector may call; empty = any host.
ALLOWED_GITEA_HOSTS=
